{
  "expo": {
    "name": "VIA",
    "slug": "via",
    "scheme": "via",
    "version": "5.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#011360"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VIA usa tu ubicación para encontrar las estaciones de combustible más cercanas y baratas.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VIA necesita acceder a tus fotos para que puedas enviar reportes de precios.",
          "cameraPermission": "Permite a VIA acceder a tu cámara para capturar displays de surtidores."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "compileSdkVersion": 36
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.siramong.via",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "VIA necesita acceso a tu ubicación para encontrar el combustible más barato cerca.",
        "NSCameraUsageDescription": "VIA necesita acceso a la cámara para capturar displays de surtidores.",
        "NSPhotoLibraryUsageDescription": "VIA necesita acceso a tus fotos para enviar reportes de precios."
      }
    },
    "android": {
      "package": "com.siramong.via",
      "adaptiveIcon": {
        "backgroundColor": "#011360",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "a233de6b-70a0-4732-ad5e-bf624c38e153"
      }
    },
    "owner": "siramong"
  }
}
